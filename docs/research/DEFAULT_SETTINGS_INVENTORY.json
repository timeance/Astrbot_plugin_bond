  {
    "path": "levels.yanwu.guidance",
    "default": "反感与回避，冷淡敷衍，抗拒亲近，语气生硬拒人于千里之外",
    "review_category": "legacy_text_not_in_new_injection"
  },
  {
    "path": "levels.yanwu.master_guidance",
    "default": "被主人伤透了心在闹大别扭，嘴硬心软、连怼带哭，实际一直盼着被哄——绝不是对外人那种拒之千里",
    "review_category": "legacy_text_not_in_new_injection"
  },
  {
    "path": "levels.yanwu.disclosure",
    "default": "不袒露任何私事与心情，多说一句都觉得烦",
